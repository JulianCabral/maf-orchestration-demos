# simulated (default, sin credenciales) | foundry | azure_openai
CHAT_CLIENT=simulated

# CHAT_CLIENT=foundry
FOUNDRY_PROJECT_ENDPOINT=https://<cuenta>.services.ai.azure.com/api/projects/<proyecto>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# CHAT_CLIENT=azure_openai
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
GROUP_CHAT_MODE=selector
